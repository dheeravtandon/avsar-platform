{
  "name": "avsar-platform",
  "version": "1.0.0",
  "private": true,
  "description": "AVSAR - Startup-friendly public procurement platform for Government of India departments",
  "license": "MIT",
  "workspaces": ["server", "client"],
  "engines": { "node": ">=22.5.0" },
  "scripts": {
    "install:all": "npm install",
    "seed": "npm run seed --workspace server",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
